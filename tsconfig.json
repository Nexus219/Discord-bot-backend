{
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/typescript/tsbuildinfo",
    "outDir": "dist",
    "module": "ESNext",
    "target": "ES2020",
    "strict": true,
    "lib": ["esnext", "dom"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "node",
    "rootDir": ".",
    "types": ["node"],
    "baseUrl": "."
  },
  "include": ["server/**/*"],  // Only backend files
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
